# Director LLM
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-4-7

# Video backend — one of: mock, veo, sora, runway
VIDEO_PROVIDER=mock

# Provider keys (only the active one needs to be set)
GOOGLE_API_KEY=
OPENAI_API_KEY=
RUNWAY_API_KEY=

# Clip parameters
CLIP_SECONDS=5
CLIP_RESOLUTION=720p

# Storage
DATABASE_URL=sqlite:///data/holodeck.db
